    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "files": [
    "dist",
    "css",
    "tailwind-preset.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
