{
  "name": "@zenith/ui-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "ZENITH design tokens — the single source of truth for the visual identity.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
