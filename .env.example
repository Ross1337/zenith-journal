# ZENITH — deployment configuration. Copy to .env and fill in.
# `docker compose up` works out of the box with these defaults (demo mode).

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_USER=zenith
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=zenith

# ── Ports / origins ──────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000
# Public URL the BROWSER uses to reach the API (inlined into the web build):
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Public URL of the web app (CORS + Stripe redirects):
WEB_ORIGIN=http://localhost:3000

# ── Auth (Clerk) — https://dashboard.clerk.com ──────────────────────
# Leave both empty for demo mode (single shared dev user, no sign-in).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Demo mode only: the user id every request is attributed to.
AUTH_DEV_USER=user_demo

# ── Billing (Stripe) — https://dashboard.stripe.com ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs: Pro $14.99/mo (recurring) and Lifetime $199 (one-time).
STRIPE_PRICE_PRO=
STRIPE_PRICE_LIFETIME=
