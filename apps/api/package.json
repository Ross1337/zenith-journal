{
  "name": "@zenith/api",
  "version": "0.1.0",
  "private": true,
  "description": "ZENITH API — NestJS. Clerk-authenticated REST, v1.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "node --watch --require ts-node/register/transpile-only src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run build && prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@zenith/calc": "*",
    "@zenith/types": "*",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^18.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
